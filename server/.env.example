# Environment Variables for Tharaa Backend
# Copy this file to .env and fill in your values

# Server
PORT=5000

# Your deployed Vercel frontend URL (no trailing slash)
CLIENT_URL=https://tharaagroup.vercel.app

# Gmail credentials for sending emails
# Use a Gmail App Password (not your real password)
# Guide: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password

# The email address that receives contact form submissions
EMAIL_RECEIVER=your-business-email@gmail.com
